#!/usr/bin/env bash
# One-command regression (design doc §8).
#   ./regress            build, unit tests, good-die matrix, fault coverage, shmoo, baseline diff
#   ./regress --accept   same, then overwrite regression/baselines/ (review the diff in your PR)
set -euo pipefail

cd "$(dirname "$0")"
ACCEPT=0
for arg in "$@"; do
  case "$arg" in
    --accept) ACCEPT=1 ;;
    -h|--help) sed -n '2,4p' "$0"; exit 0 ;;
    *) echo "regress: unknown argument $arg" >&2; exit 2 ;;
  esac
done

export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)}"
BIN=build/regress/testprog/i86test
OUT=out
GRADES=8086,8086-2,8086-1
VCC=4.5,5.0,5.5
TEMP=0,70

echo "== [1/4] configure, build, unit tests"
cmake --workflow --preset regress

rm -rf "$OUT"
mkdir -p "$OUT"
status=0

echo "== [2/4] good die: all tests x grades {$GRADES} x VCC {$VCC} x TA {$TEMP}"
"$BIN" --die spec/dies/good.yaml --grade "$GRADES" --vcc "$VCC" --temp "$TEMP" \
       --tests '*' --out "$OUT/good" || status=1

echo "== [3/4] fault coverage: spec/dies/fault_*.yaml vs regression/expected.yaml"
# Grades x VCC {4.5, 5.5} x TA {70}: the same caught sets as the full matrix, at a third of the time.
"$BIN" --coverage regression/expected.yaml --dies spec/dies --grade "$GRADES" --vcc 4.5,5.5 \
       --temp 70 --out "$OUT/faults" || status=1

echo "== [4/4] shmoo (good, marginal) and baseline diff"
SHMOO_DIES=(good marginal)
for die in "${SHMOO_DIES[@]}"; do
  "$BIN" --shmoo --die "spec/dies/$die.yaml" --out "$OUT/shmoo_$die" || status=1
done

mkdir -p regression/baselines
baselines=("$OUT/good/results.csv:good_results.csv")
for die in "${SHMOO_DIES[@]}"; do baselines+=("$OUT/shmoo_$die/shmoo.csv:shmoo_$die.csv"); done
for pair in "${baselines[@]}"; do
  src=${pair%%:*}
  base=regression/baselines/${pair##*:}
  if [ "$ACCEPT" -eq 1 ]; then
    cp "$src" "$base"
    echo "   accepted: $base"
  elif [ -f "$base" ]; then
    if ! diff -u "$base" "$src"; then
      echo "   $src differs from $base (run ./regress --accept if intended)"
      status=1
    fi
  else
    echo "   (no baseline $base yet)"
  fi
done

cp "$OUT/good/summary.md" "$OUT/summary.md"
if [ -f "$OUT/faults/coverage.md" ]; then { echo; cat "$OUT/faults/coverage.md"; } >> "$OUT/summary.md"; fi
for die in "${SHMOO_DIES[@]}"; do cp "$OUT/shmoo_$die/shmoo.svg" "$OUT/shmoo_$die.svg"; done
if [ "$status" -eq 0 ]; then echo "== regress: PASS"; else echo "== regress: FAIL"; fi
exit "$status"
