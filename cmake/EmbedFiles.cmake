# cmake -DOUT=<file.cpp> -DROMS="name=path;..." -DPATTERNS="name=path;..." -DNASM_FOUND=ON|OFF
#       -P EmbedFiles.cmake
# Writes a C++ source that defines i8086::testprog::embedded::{roms,patterns,nasm_found}.

function(i86_emit_table var table_name entries)
  set(defs "")
  set(rows "")
  set(i 0)
  foreach(entry IN LISTS entries)
    string(FIND "${entry}" "=" eq)
    string(SUBSTRING "${entry}" 0 ${eq} name)
    math(EXPR start "${eq} + 1")
    string(SUBSTRING "${entry}" ${start} -1 path)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    if(hex_len EQUAL 0)
      message(FATAL_ERROR "EmbedFiles: ${path} is empty")
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n    " bytes "${bytes}")
    string(APPEND defs "constexpr unsigned char ${table_name}_${i}[] = {\n    ${bytes}};\n")
    string(APPEND rows "    {\"${name}\", {${table_name}_${i}, sizeof ${table_name}_${i}}},\n")
    math(EXPR i "${i} + 1")
  endforeach()
  if(i EQUAL 0)
    set(body "  return {};\n")
  else()
    set(body "  static const Blob table[] = {\n${rows}  };\n  return table;\n")
  endif()
  set(${var} "namespace {\n${defs}}  // namespace\n\nstd::span<const Blob> ${table_name}() {\n${body}}\n" PARENT_SCOPE)
endfunction()

i86_emit_table(rom_src roms "${ROMS}")
i86_emit_table(pat_src patterns "${PATTERNS}")
if(NASM_FOUND)
  set(nasm "true")
else()
  set(nasm "false")
endif()

file(WRITE "${OUT}.tmp" "// Generated by cmake/EmbedFiles.cmake. Do not edit.
#include \"embedded.hpp\"

namespace i8086::testprog::embedded {

${rom_src}
${pat_src}
bool nasm_found() { return ${nasm}; }

}  // namespace i8086::testprog::embedded
")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
