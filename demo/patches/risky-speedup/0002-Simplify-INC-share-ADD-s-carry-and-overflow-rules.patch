From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Wed, 11 Nov 2026 00:52:30 +0000
Subject: [PATCH] Simplify INC: share ADD's carry and overflow rules

Co-authored-by: W L <liwillbiz@users.noreply.github.com>
---
 libs/model/src/behavioral/core_eu.cpp | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/libs/model/src/behavioral/core_eu.cpp b/libs/model/src/behavioral/core_eu.cpp
index 4ef795b..8280fbb 100644
--- a/libs/model/src/behavioral/core_eu.cpp
+++ b/libs/model/src/behavioral/core_eu.cpp
@@ -171,7 +171,12 @@ uint16_t Core::inc_dec(uint16_t a16, bool dec, bool word) {
   const uint32_t sign = word ? 0x8000 : 0x80;
   const uint32_t a = a16 & mask;
   const uint32_t r = (dec ? a - 1 : a + 1) & mask;
-  set_flag(kOF, dec ? a == sign : r == sign);
+  if (dec) {
+    set_flag(kOF, a == sign);
+  } else {  // same flag rules as ADD with b = 1
+    set_flag(kCF, r > mask);
+    set_flag(kOF, ((a ^ r) & (1 ^ r) & sign) != 0);
+  }
   set_flag(kAF, ((a ^ 1 ^ r) & 0x10) != 0);
   set_szp(u16(r), word);
   if (!dec && bug_inc_clears_cf_) set_flag(kCF, false);
